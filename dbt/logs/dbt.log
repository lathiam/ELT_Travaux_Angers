    -- Informations de contact
    contact,
    email,

    -- Métadonnées
    istramway as est_tramway,
    idparking as id_parking,

    -- Horodatage de mise à jour
    CURRENT_TIMESTAMP() as _updated_at
FROM source
    );
  
