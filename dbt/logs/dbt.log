-- Données nettoyées et standardisées
WITH source AS (
    SELECT * FROM `my-project-travaux-angers`.`travaux_angers_bronze`.`src_travaux_angers`
)

SELECT
    id,
    title as titre,
    TIMESTAMP(startat) as date_debut,
    TIMESTAMP(endat) as date_fin,
    impact,
    CAST(coordinate_x as FLOAT64) as longitude,
    CAST(coordinate_y as FLOAT64) as latitude,
    type,
    COALESCE(description, 'Non spécifié') as description,
    CURRENT_TIMESTAMP() as _updated_at
FROM source
    );
  
