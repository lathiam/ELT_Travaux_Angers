    create or replace table `my-project-travaux-angers`.`travaux_angers_gold`.`fct_travaux_stats`
      
    
    

    
    OPTIONS()
    as (
      -- Modèle pour les analyses temporelles et les statistiques
WITH statistiques_travaux AS (
    SELECT
        type as type_travaux,
        traffic as niveau_impact,
        DATE_TRUNC(date_debut, MONTH) as mois,
        COUNT(*) as nombre_travaux,
        AVG(TIMESTAMP_DIFF(date_fin, date_debut, DAY)) as duree_moyenne_jours,
        -- Statistiques par impact
        COUNTIF(traffic = 'deviated') as travaux_impact_fort,
        COUNTIF(traffic = 'modified') as travaux_impact_moyen,
        COUNTIF(traffic = 'normal') as travaux_impact_faible,
        -- État actuel
        COUNTIF(CURRENT_TIMESTAMP() BETWEEN date_debut AND date_fin) as travaux_en_cours,
        -- Coordonnées pour agrégation spatiale
        ANY_VALUE(ST_GEOGPOINT(longitude, latitude)) as position_representative
    FROM `my-project-travaux-angers`.`travaux_angers_silver`.`stg_travaux_angers`
    GROUP BY
        type_travaux,
        niveau_impact,
        mois
)

SELECT
    *,
    travaux_impact_fort + travaux_impact_moyen + travaux_impact_faible as total_travaux,
    SAFE_DIVIDE(travaux_en_cours, nombre_travaux) as ratio_actif
FROM statistiques_travaux
    );
  
