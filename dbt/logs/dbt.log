    create or replace table `my-project-travaux-angers`.`travaux_angers_gold`.`fct_travaux_stats`
      
    
    

    
    OPTIONS()
    as (
      WITH src_norm_raw AS (
  -- Normalisation des géométries depuis divers formats
  SELECT
    id,
    type,
    startat,
    endat,
    description,
    title,
    address,
    CAST(location AS STRING) AS location_str,
    CASE
      WHEN REGEXP_CONTAINS(CAST(location AS STRING), r'"type"\s*:\s*"FeatureCollection"') THEN
        ST_GEOGFROMGEOJSON(JSON_EXTRACT(CAST(location AS STRING), '$.features[0].geometry'))
      WHEN REGEXP_CONTAINS(CAST(location AS STRING), r'"type"\s*:\s*"Feature"') THEN
        ST_GEOGFROMGEOJSON(JSON_EXTRACT(CAST(location AS STRING), '$.geometry'))
      WHEN REGEXP_CONTAINS(CAST(location AS STRING),
           r'"type"\s*:\s*"(Point|LineString|Polygon|MultiPoint|MultiLineString|MultiPolygon|GeometryCollection)"') THEN
        ST_GEOGFROMGEOJSON(CAST(location AS STRING))
      WHEN REGEXP_CONTAINS(CAST(location AS STRING), r'^\s*(POINT|LINESTRING|POLYGON|MULTI|GEOMETRYCOLLECTION)\b') THEN
        ST_GEOGFROMTEXT(CAST(location AS STRING))
      WHEN REGEXP_CONTAINS(CAST(location AS STRING), r'^\s*-?\d+(\.\d+)?\s*,\s*-?\d+(\.\d+)?\s*$') THEN
        ST_GEOGPOINT(
          CAST(SPLIT(CAST(location AS STRING), ',')[OFFSET(0)] AS FLOAT64), -- lon
          CAST(SPLIT(CAST(location AS STRING), ',')[OFFSET(1)] AS FLOAT64)  -- lat
        )
      ELSE NULL
    END AS position
  FROM `my-project-travaux-angers`.`travaux_angers_bronze`.`src_travaux_angers`
),

src_norm AS (
  -- Déduplication SANS DISTINCT (interdit sur GEOGRAPHY) :
  -- on utilise un hash WKT pour l’égalité géométrique
  SELECT
    id,
    type,
    startat,
    endat,
    description,
    title,
    address,
    position
  FROM (
    SELECT
      id,
      type,
      startat,
      endat,
      description,
      title,
      address,
      position,
      ROW_NUMBER() OVER (
        PARTITION BY
          id, type, startat, endat, description, title, address,
          COALESCE(ST_ASTEXT(position), 'NULL_GEOM')
        ORDER BY id
      ) AS _rn
    FROM src_norm_raw
  )
  WHERE _rn = 1
),

travaux_quotidiens AS (
  -- Génère les jours par chantier, ajoute un flag géométrie et dédoublonne par (id, date_jour)
  SELECT
    id,
    type AS type_travaux,
    startat AS date_debut,
    endat   AS date_fin,
    position,
    description,
    title   AS titre,
    address AS adresse,
    CASE
      WHEN LOWER(description) LIKE '%fort%' OR LOWER(description) LIKE '%important%' THEN 'FORT'
      WHEN LOWER(description) LIKE '%moyen%' OR LOWER(description) LIKE '%modéré%'   THEN 'MOYEN'
      ELSE 'FAIBLE'
    END AS impact_circulation,
    DATE_DIFF(endat, startat, DAY) AS duree_prevue,
    CASE
      WHEN CURRENT_DATE() > DATE(endat) AND DATE(startat) <= CURRENT_DATE() THEN 'Oui'
      ELSE 'Non'
    END AS en_retard,
    CASE
      WHEN CURRENT_DATE() > DATE(endat) AND DATE(startat) <= CURRENT_DATE()
      THEN DATE_DIFF(CURRENT_DATE(), DATE(endat), DAY)
      ELSE 0
    END AS retard_jours,
    date_jour,
    EXTRACT(MONTH FROM date_jour)     AS mois,
    EXTRACT(DAYOFWEEK FROM date_jour) AS jour_semaine,
    CASE WHEN position IS NOT NULL THEN 1 ELSE 0 END AS a_geometrie
  FROM src_norm t
  CROSS JOIN UNNEST(GENERATE_DATE_ARRAY(DATE(t.startat), DATE(t.endat))) AS date_jour
  QUALIFY ROW_NUMBER() OVER (PARTITION BY id, date_jour ORDER BY date_jour) = 1
),

stats_agregees AS (
  -- Aucune utilisation de DISTINCT sur GEOGRAPHY
  SELECT
    date_jour,
    type_travaux,
    COUNT(DISTINCT id) AS total_travaux_type,
    COUNTIF(DATE(date_jour) BETWEEN DATE(date_debut) AND DATE(date_fin)) AS travaux_actifs_type,
    COUNTIF(en_retard = 'Oui') AS travaux_retard_type,
    AVG(duree_prevue) AS duree_moyenne_type,
    AVG(retard_jours) AS retard_moyen_type,
    COUNTIF(impact_circulation = 'FORT')  AS impact_fort_count,
    COUNTIF(impact_circulation = 'MOYEN') AS impact_moyen_count,
    COUNTIF(impact_circulation = 'FAIBLE') AS impact_faible_count,
    ST_UNION_AGG(position) AS zone_travaux,
    SAFE_DIVIDE(
      COUNTIF(position IS NOT NULL),
      NULLIF(ST_AREA(ST_CONVEXHULL(ST_UNION_AGG(position))), 0)
    ) AS densite_spatiale
  FROM travaux_quotidiens
  GROUP BY date_jour, type_travaux
)

SELECT
  t.date_jour,
  t.type_travaux,
  t.id AS travaux_id,
  t.mois,
  t.jour_semaine,
  t.titre,
  t.adresse,
  ST_ASTEXT(t.position) AS position,
  t.a_geometrie,
  t.date_debut,
  t.date_fin,
  CASE
    WHEN DATE(t.date_jour) BETWEEN DATE(t.date_debut) AND DATE(t.date_fin) THEN 1
    ELSE 0
  END AS est_actif,
  t.en_retard,
  t.duree_prevue,
  t.retard_jours,
  s.total_travaux_type,
  s.travaux_actifs_type,
  s.travaux_retard_type,
  s.duree_moyenne_type,
  s.retard_moyen_type,
  t.impact_circulation AS niveau_impact,
  s.impact_fort_count,
  s.impact_moyen_count,
  s.impact_faible_count,
  SAFE_DIVIDE(s.travaux_actifs_type, s.total_travaux_type) AS taux_occupation,
  SAFE_DIVIDE(s.travaux_retard_type, s.travaux_actifs_type) AS taux_retard,
  s.densite_spatiale,
  ST_ASTEXT(s.zone_travaux) AS zone_travaux,
  CURRENT_TIMESTAMP() AS _updated_at
FROM travaux_quotidiens t
LEFT JOIN stats_agregees s
  ON t.date_jour = s.date_jour
 AND t.type_travaux = s.type_travaux
ORDER BY
  t.date_jour DESC,
  t.type_travaux,
  t.id
    );
  
