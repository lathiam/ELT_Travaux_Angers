    create or replace table `my-project-travaux-angers`.`travaux_angers_gold`.`dim_travaux_details`
      
    
    

    
    OPTIONS()
    as (
      -- Modèle pour la visualisation des travaux actifs et leurs caractéristiques
WITH enriched_travaux AS (
    SELECT
        id,
        titre,
        type as type_travaux,
        date_debut,
        date_fin,
        DATE_DIFF(date_fin, date_debut, DAY) as duree_prevue,
        CASE
            WHEN CURRENT_DATE() BETWEEN DATE(date_debut) AND DATE(date_fin) THEN 'En cours'
            WHEN CURRENT_DATE() > DATE(date_fin) THEN 'Terminé'
            WHEN CURRENT_DATE() < DATE(date_debut) THEN 'Planifié'
        END as statut,
        adresse,
        coordonnees as position,
        description,
        CASE
            WHEN LOWER(description) LIKE '%fort%' OR LOWER(description) LIKE '%important%' THEN 'FORT'
            WHEN LOWER(description) LIKE '%moyen%' OR LOWER(description) LIKE '%modéré%' THEN 'MOYEN'
            ELSE 'FAIBLE'
        END as impact_circulation,
        DATETIME_TRUNC(date_debut, MONTH) as mois_debut,
        DATETIME_TRUNC(date_debut, YEAR) as annee_debut
    FROM `my-project-travaux-angers`.`travaux_angers_silver`.`stg_travaux_angers`
)

SELECT
    *,
    CASE
        WHEN CURRENT_DATE() > DATE(date_fin) AND statut = 'En cours' THEN TRUE
        ELSE FALSE
    END as is_delayed,
    CASE
        WHEN CURRENT_DATE() > DATE(date_fin) AND statut = 'En cours'
        THEN DATE_DIFF(CURRENT_DATE(), DATE(date_fin), DAY)
        ELSE 0
    END as retard_jours
FROM enriched_travaux
    );
  
